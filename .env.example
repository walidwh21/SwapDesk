# Copy to .env.local and fill in what you need. Never commit real keys.

# --- Contracts deployed from this repo (printed by `npm run deploy:local`) ---
NEXT_PUBLIC_SINGLE_HOP=
NEXT_PUBLIC_MULTI_HOP=
NEXT_PUBLIC_REGISTRY=

# --- Optional overrides for non-mainnet / local Uniswap deployments ---
# NEXT_PUBLIC_WETH=
# NEXT_PUBLIC_FACTORY=
# NEXT_PUBLIC_QUOTER=
# NEXT_PUBLIC_POSITION_MANAGER=

# --- Optional: Uniswap V3 subgraph endpoint for the Tokens page ---
NEXT_PUBLIC_SUBGRAPH_URL=

# --- Hardhat only: your own RPC endpoint to fork mainnet in tests ---
FORK_RPC_URL=
